{
	"name": "swiss-knife-dev-tools",
	"displayName": "Swiss Knife Dev Tools",
	"icon": "image/swiss-knife-icon-512.png",
	"description": "Hashers, converters, encoders, formatters and other utilities",
	"version": "0.1.2",
	"author": "Code2Business.com",
	"publisher": "code2business",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/code2business-open/vscode-swiss-knife.git"
	},
	"engines": {
		"vscode": "^1.95.0"
	},
	"categories": [
		"Other",
		"Formatters"
	],
	"main": "./dist/extension.js",
	"extensionKind": [
		"workspace"
	],
	"capabilities": {
		"untrustedWorkspaces": {
			"supported": true
		},
		"virtualWorkspaces": true
	},
	"scripts": {
		"generate": "node tools/generate.cjs",
		"compile": "npm run generate && node tools/build-sql.cjs && tsc -p .",
		"test": "npm run compile && node --test test/unit.cjs test/sql.cjs",
		"test:integration": "npm run compile && node test/run-integration.cjs",
		"vscode:prepublish": "npm run compile",
		"package": "vsce package --allow-missing-repository --out artifacts/swiss-knife-0.1.2.vsix",
		"import:scripts": "node tools/import-scripts.cjs"
	},
	"devDependencies": {
		"@types/node": "^20.0.0",
		"@types/vscode": "~1.95.0",
		"@vscode/test-electron": "^2.5.0",
		"@vscode/vsce": "^3.0.0",
		"esbuild": "0.28.2",
		"jsonc-parser": "^3.3.1",
		"sql-formatter": "15.9.1",
		"typescript": "^5.7.0"
	},
