		"configuration": {
			"title": "Swiss Knife",
			"properties": {
				"swissKnife.sqlDialect": {
					"type": "string",
					"enum": [
						"mysql",
						"mariadb",
						"postgresql",
						"transactsql",
						"sqlite"
					],
					"enumDescriptions": [
						"MySQL",
						"MariaDB",
						"PostgreSQL",
						"SQL Server (T-SQL)",
						"SQLite"
					],
					"default": "mysql",
					"scope": "resource",
					"description": "SQL dialect used by SK: Format: Format SQL."
				},
				"swissKnife.sqlQuoteIdentifiers": {
					"type": "boolean",
					"default": true,
					"scope": "resource",
					"description": "Automatically quote SQL database, schema, table, column, CTE, and alias identifiers using the selected dialect. Existing identifier quotes are preserved when disabled."
				}
			}
		}
